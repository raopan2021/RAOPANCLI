{
  "name": "raopancli",
  "type": "module",
  "version": "1.0.13",
  "packageManager": "pnpm@9.15.9",
  "description": "raopan 的 JavaScript 脚手架工具",
  "author": "raopan2021",
  "license": "ISC",
  "keywords": [
    "cli",
    "scaffold",
    "vite",
    "raopan"
  ],
  "main": "index.js",
  "bin": {
    "raopancli": "./bin/index.js",
    "rp": "./bin/index.js"
  },
  "files": [
    "README.md",
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "node ./test/z.js",
    "build": "node ./scripts/build.mjs",
    "test": "node ./test/z.js && node ./test/deploy-test.mjs",
    "release": "node ./scripts/publish.mjs",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --cache",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "figlet": "^1.11.4",
    "fs-extra": "^11.4.0",
    "inquirer": "^14.1.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "boxen": "^8.0.1",
    "dayjs": "^1.11.23",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "gradient-string": "^3.0.0",
    "jiti": "^2.7.0",
    "vitepress": "^1.6.4"
  }
}
